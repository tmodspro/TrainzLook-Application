{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrainzLook",
  "version": "0.2.0",
  "identifier": "com.trainzlook.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TrainzLook",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "INDORAILS",
    "copyright": "Copyright © 2026 INDORAILS. All rights reserved.",
    "licenseFile": "../../LICENSE",
    "targets": ["nsis"],
    "fileAssociations": [
      { "ext": ["im"], "name": "TrainzLook.Mesh", "description": "Trainz mesh", "role": "Viewer" }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installerIcon": "icons/icon.ico" }
    }
  }
}
